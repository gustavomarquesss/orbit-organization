# Copie para .env.local e preencha com os valores impressos por `npx supabase start`
# (ou, em produção, os valores do seu projeto Supabase na nuvem em Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: assistente (bolinha no canto). Sem a chave ele responde só as perguntas
# conhecidas (hoje, urgente, prioridade, atrasado...); com a chave, o Claude responde o resto.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5

# Usada apenas em Server Actions restritas (ex.: convite de equipe). Nunca exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=
