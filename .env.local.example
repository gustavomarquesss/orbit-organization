# Copie para .env.local e preencha com os valores impressos por `npx supabase start`
# (ou, em produção, os valores do seu projeto Supabase na nuvem em Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas em Server Actions restritas (ex.: convite de equipe). Nunca exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=
